# Copy to .env.local. Find the project URL and publishable key in the Supabase Dashboard's Connect dialog.
# Use the HTTPS project root URL without an API path, query, or fragment.
# A legacy anon key from Settings > API Keys is also accepted.
# Keep secret and service_role keys out of frontend configuration. Once configured, RLS protects task data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
